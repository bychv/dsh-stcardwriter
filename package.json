{
  "name": "dsh-stcardwriter",
  "version": "0.5.2-rc.1",
  "description": "DeepSeek Harness authoring mode for SillyTavern character cards, lorebooks, and presets, with a local SillyTavern connector and Preset Plus integration.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./agent-tools": "./dist/agent-tools.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "agent-presets",
    "scripts/check-dsh-compat.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "test": "npm run build && node --test --test-concurrency=1",
    "check": "tsc --noEmit",
    "check:dsh-compat": "node scripts/check-dsh-compat.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0-rc.8",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.8",
    "react": ">=18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.2",
    "react": "^19.1.1",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "sillytavern",
    "sillytavern-plugin",
    "character-card",
    "character-card-v3",
    "lorebook",
    "worldbook",
    "preset-editor",
    "agent-tools",
    "preset-plus"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bychv/dsh-stcardwriter.git"
  },
  "bugs": {
    "url": "https://github.com/bychv/dsh-stcardwriter/issues"
  },
  "homepage": "https://github.com/bychv/dsh-stcardwriter#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "dependencies": {
    "@rain-kl/dsh-preset-plus": "0.1.5"
  }
}
